import sys
gender = input("请输入您的性别：")
if gender == "女":
    print("您好，女士！")
elif gender == "男":
    print("您好，先生！")
else:
    print("你确定你是人类这个物种再说^^")
    sys.exit()

user_weight = float(input("请输入您的体重（单位：kg）:"))
user_height = float(input("请输入您的身高（单位：m）:"))
user_BMI = user_weight / (user_height) ** 2
print("您的BMI值为：" + str(user_BMI))

if gender == "女":
    if user_BMI <= 18.5:
        print("此BMI值属于偏瘦范围，要多吃点咯！")
    elif 18.5 < user_BMI <= 25:
        print("此BMI值属于正常范围，恭喜你十分健康！")
    elif 25 < user_BMI <= 30:
        print("此BMI值属于偏胖范围，该运动啦！")
    else:
        print("此BMI值属于肥胖范围！要减肥啦！！")
elif gender == "男":      #注意这里要用elif，否则python会把后面的else判定为跟第二个if链接！！
    if user_BMI <= 18.5:
        print("此BMI值属于偏瘦范围")
    elif 18.5 < user_BMI <= 25:
        print("此BMI值属于正常范围")
    elif 25 < user_BMI <=30:
        print("此BMI值属于偏胖范围")
    else:
        print("此BMI值属于肥胖范围")
